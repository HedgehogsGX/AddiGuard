# Required: key for the OpenAI-compatible vision provider.
OPENAI_API_KEY=your-provider-api-key
# Optional OpenAI-compatible endpoint and vision-capable model.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=45
# Optional path to an older installation database for additive-table cleanup.
# LEGACY_DB_PATH=/absolute/path/to/instance/addiguard.db
